<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="mars">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

    <light name="mars_sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 200 0 0.3 0</pose>
      <diffuse>0.85 0.55 0.35 1</diffuse>
      <specular>0.2 0.15 0.1 1</specular>
      <direction>-0.4 0.1 -0.9</direction>
    </light>

    <model name="mars_terrain">
      <static>true</static>
      <link name="terrain_link">

        <collision name="terrain_col">
          <geometry>
            <heightmap>
              <uri>model://mars_heightmap.png</uri>
              <size>50 50 5</size>
              <pos>0 0 0</pos>
            </heightmap>
          </geometry>
        </collision>

        <visual name="terrain_vis">
          <geometry>
            <heightmap>
              <uri>/home/anri/ros2_ws/src/my_robot_project/models/mars_heightmap.png</uri>
              <size>50 50 5</size>
              <pos>0 0 0</pos>
            </heightmap>
          </geometry>
          <material>
            <ambient>0.6 0.35 0.2 1</ambient>
            <diffuse>0.7 0.4 0.25 1</diffuse>
          </material>
        </visual>

      </link>
    </model>

  </world>
</sdf>