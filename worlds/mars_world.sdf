<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="mars">

    <physics name="1ms" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

    <scene>
      <sky></sky>
      <grid>true</grid>
      <ambient>0.3 0.3 0.3</ambient>
      <background>0.4 0.4 0.4</background>
    </scene>

    <light name="mars_sun" type="directional">
      <pose>0 0 200 0 0.3 0</pose>
      <diffuse>0.85 0.55 0.35 1</diffuse>
      <specular>0.2 0.15 0.1 1</specular>
      <direction>-0.4 0.1 -0.9</direction>
      <cast_shadows>false</cast_shadows>
    </light>

    <model name="mars_terrain">
      <static>true</static>
      <link name="terrain_link">

        <collision name="terrain_col">
          <geometry>
            <heightmap>
              <uri>model://mars_heightmap.png</uri>
              <size>50 50 1.5</size>
              <pos>0 0 0</pos>
            </heightmap>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
          </surface>
        </collision>

        <visual name="terrain_vis">
          <pose>0 0 -0.025 0 0 0</pose>
          <geometry>
            <box>
              <size>50 50 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.35 0.2 1</ambient>
            <diffuse>0.7 0.4 0.25 1</diffuse>
          </material>
        </visual>

      </link>
    </model>

  </world>
</sdf>