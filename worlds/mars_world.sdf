<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="mars">

    <physics name="1ms" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

    <scene>
      <sky></sky>
      <grid>true</grid>
      <ambient>0.3 0.3 0.3</ambient>
      <background>0.4 0.4 0.4</background>
    </scene>

    <!-- Required for any sensor in the world to produce data -->
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light name="mars_sun" type="directional">
      <pose>0 0 200 0 0.3 0</pose>
      <diffuse>0.85 0.55 0.35 1</diffuse>
      <specular>0.2 0.15 0.1 1</specular>
      <direction>-0.4 0.1 -0.9</direction>
      <cast_shadows>false</cast_shadows>
    </light>

    <model name="mars_terrain">
      <static>true</static>
      <link name="terrain_link">

        <collision name="terrain_col">
          <geometry>
            <box>
              <size>100 100 0.1</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
          </surface>
        </collision>

        <visual name="terrain_vis">
          <geometry>
            <mesh>
              <uri>model://mars_terrain.obj</uri>
              <scale>2 2 1</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.6 0.35 0.2 1</ambient>
            <diffuse>0.7 0.4 0.25 1</diffuse>
          </material>
        </visual>

      </link>
    </model>

    <include>
      <uri>model://rover</uri>
      <name>rover</name>
      <pose>0 0 2.0 0 0 0</pose>
    </include>

    <!-- Flat ground under the terrain (keeps robot from falling) -->
    <model name="flat_ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>200 200 1</size></box></geometry>
          <surface>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>200 200 1</size></box></geometry>
          <transparency>1.0</transparency>
        </visual>
      </link>
    </model>

    <!-- Waypoint markers (yellow spheres at each waypoint) -->
    <model name="wp_0"><static>true</static><pose>5 0 1 0 0 0</pose><link name="l"><visual name="v"><geometry><sphere><radius>0.2</radius></sphere></geometry><material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material></visual></link></model>
    <model name="wp_1"><static>true</static><pose>5 5 1 0 0 0</pose><link name="l"><visual name="v"><geometry><sphere><radius>0.2</radius></sphere></geometry><material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material></visual></link></model>
    <model name="wp_2"><static>true</static><pose>0 5 1 0 0 0</pose><link name="l"><visual name="v"><geometry><sphere><radius>0.2</radius></sphere></geometry><material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material></visual></link></model>
    <model name="wp_3"><static>true</static><pose>-5 5 1 0 0 0</pose><link name="l"><visual name="v"><geometry><sphere><radius>0.2</radius></sphere></geometry><material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material></visual></link></model>
    <model name="wp_4"><static>true</static><pose>-5 0 1 0 0 0</pose><link name="l"><visual name="v"><geometry><sphere><radius>0.2</radius></sphere></geometry><material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material></visual></link></model>
    <model name="wp_5"><static>true</static><pose>0 0 1 0 0 0</pose><link name="l"><visual name="v"><geometry><sphere><radius>0.2</radius></sphere></geometry><material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material></visual></link></model>

    <model name="rock_1">
      <static>true</static>
      <pose>5 2 1.0 0.5 0.2 1.0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.8 0.6 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.8 0.6 0.4</size></box></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="rock_2">
      <static>true</static>
      <pose>-4 -6 0.9 0.1 0.8 0.3</pose>
      <link name="link">
        <collision name="collision">
