<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="rover">
    <link name="base_link">
      <pose>0 0 0.8 0 0 0</pose>
      <inertial>
        <mass>1025</mass>
        <inertia><ixx>10</ixx><iyy>25</iyy><izz>20</izz></inertia>
      </inertial>
      <collision name="base_link_collision">
        <geometry><box><size>1.2 1.0 0.4</size></box></geometry>
        <surface><friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction></surface>
      </collision>
      <visual name="base_visual">
        <geometry><box><size>1.2 1.0 0.6</size></box></geometry>
        <material><ambient>0.9 0.85 0.8 1</ambient><diffuse>1 0.95 0.9 1</diffuse></material>
      </visual>
    </link>

    <!-- Optimized Wheels -->
    <link name="left_wheel1"><pose>1.14 -1.1 0.26 0 0 0</pose>
      <collision name="c"><pose>0 0 0 -1.5708 0 0</pose><geometry><cylinder><radius>0.27</radius><length>0.25</length></cylinder></geometry>
      <surface><friction><ode><mu>2.5</mu><mu2>2.0</mu2></ode></friction></surface></collision>
      <visual name="v"><pose>0 0 0 -1.5708 0 0</pose><geometry><cylinder><radius>0.27</radius><length>0.33</length></cylinder></geometry></visual></link>
    <link name="left_wheel2"><pose>0.08 -1.1 0.26 0 0 0</pose>
      <collision name="c"><pose>0 0 0 -1.5708 0 0</pose><geometry><cylinder><radius>0.27</radius><length>0.25</length></cylinder></geometry>
      <surface><friction><ode><mu>2.5</mu><mu2>2.0</mu2></ode></friction></surface></collision>
      <visual name="v"><pose>0 0 0 -1.5708 0 0</pose><geometry><cylinder><radius>0.27</radius><length>0.33</length></cylinder></geometry></visual></link>
    <link name="left_wheel3"><pose>-1.07 -1.1 0.26 0 0 0</pose>
      <collision name="c"><pose>0 0 0 -1.5708 0 0</pose><geometry><cylinder><radius>0.27</radius><length>0.25</length></cylinder></geometry>
      <surface><friction><ode><mu>2.5</mu><mu2>2.0</mu2></ode></friction></surface></collision>
      <visual name="v"><pose>0 0 0 -1.5708 0 0</pose><geometry><cylinder><radius>0.27</radius><length>0.33</length></cylinder></geometry></visual></link>
    <link name="right_wheel1"><pose>1.14 1.1 0.26 0 0 0</pose>
      <collision name="c"><pose>0 0 0 -1.5708 0 0</pose><geometry><cylinder><radius>0.27</radius><length>0.25</length></cylinder></geometry>
      <surface><friction><ode><mu>2.5</mu><mu2>2.0</mu2></ode></friction></surface></collision>
      <visual name="v"><pose>0 0 0 -1.5708 0 0</pose><geometry><cylinder><radius>0.27</radius><length>0.33</length></cylinder></geometry></visual></link>
    <link name="right_wheel2"><pose>0.08 1.1 0.26 0 0 0</pose>
      <collision name="c"><pose>0 0 0 -1.5708 0 0</pose><geometry><cylinder><radius>0.27</radius><length>0.25</length></cylinder></geometry>
      <surface><friction><ode><mu>2.5</mu><mu2>2.0</mu2></ode></friction></surface></collision>
      <visual name="v"><pose>0 0 0 -1.5708 0 0</pose><geometry><cylinder><radius>0.27</radius><length>0.33</length></cylinder></geometry></visual></link>
    <link name="right_wheel3"><pose>-1.07 1.1 0.26 0 0 0</pose>
      <collision name="c"><pose>0 0 0 -1.5708 0 0</pose><geometry><cylinder><radius>0.27</radius><length>0.25</length></cylinder></geometry>
      <surface><friction><ode><mu>2.5</mu><mu2>2.0</mu2></ode></friction></surface></collision>
      <visual name="v"><pose>0 0 0 -1.5708 0 0</pose><geometry><cylinder><radius>0.27</radius><length>0.33</length></cylinder></geometry></visual></link>

    <joint name="left_wheel1_j" type="revolute"><parent>base_link</parent><child>left_wheel1</child><axis><xyz>0 1 0</xyz></axis></joint>
    <joint name="left_wheel2_j" type="revolute"><parent>base_link</parent><child>left_wheel2</child><axis><xyz>0 1 0</xyz></axis></joint>
    <joint name="left_wheel3_j" type="revolute"><parent>base_link</parent><child>left_wheel3</child><axis><xyz>0 1 0</xyz></axis></joint>
    <joint name="right_wheel1_j" type="revolute"><parent>base_link</parent><child>right_wheel1</child><axis><xyz>0 1 0</xyz></axis></joint>
    <joint name="right_wheel2_j" type="revolute"><parent>base_link</parent><child>right_wheel2</child><axis><xyz>0 1 0</xyz></axis></joint>
    <joint name="right_wheel3_j" type="revolute"><parent>base_link</parent><child>right_wheel3</child><axis><xyz>0 1 0</xyz></axis></joint>

    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel1_j</left_joint><left_joint>left_wheel2_j</left_joint><left_joint>left_wheel3_j</left_joint>
      <right_joint>right_wheel1_j</right_joint><right_joint>right_wheel2_j</right_joint><right_joint>right_wheel3_j</right_joint>
      <wheel_separation>2.2</wheel_separation><wheel_radius>0.27</wheel_radius>
      <topic>/rover/cmd_vel</topic><odom_topic>/rover/odometry</odom_topic>
      <max_linear_acceleration>3.0</max_linear_acceleration>
    </plugin>

    <link name="lidar_link">
      <pose>0.65 0 1.1 0 0.3 0</pose> <!-- 17 degree tilt down -->
      <sensor name="lidar" type="gpu_lidar">
        <topic>/scan</topic><update_rate>10</update_rate><gz_frame_id>lidar_link</gz_frame_id>
        <lidar>
          <scan><horizontal><samples>360</samples><min_angle>-3.14</min_angle><max_angle>3.14</max_angle></horizontal></scan>
          <range><min>0.1</min><max>12.0</max></range>
        </lidar>
      </sensor>
    </link>
    <joint name="lidar_joint" type="fixed"><parent>base_link</parent><child>lidar_link</child></joint>
  </model>
</sdf>
