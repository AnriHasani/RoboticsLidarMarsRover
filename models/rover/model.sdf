<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="rover">
    <link name="base_link">
      <pose>0 0 0.8 0 0 0</pose>
      <inertial>
        <mass>1025</mass>
        <inertia>
          <ixx>10</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>25</iyy><iyz>0</iyz>
          <izz>20</izz>
        </inertia>
