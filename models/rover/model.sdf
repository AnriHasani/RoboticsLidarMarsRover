<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="rover">
    <link name="base_link">
      <pose>0 0 0.8 0 0 0</pose>
      <inertial>
        <mass>1025</mass>
        <inertia>
          <ixx>10</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>25</iyy><iyz>0</iyz>
          <izz>20</izz>
        </inertia>
      </inertial>
      <collision name="base_link_collision">
        <geometry>
          <box><size>1.2 1.0 0.6</size></box>
        </geometry>
        <surface>
          <friction>
            <ode><mu>0.5</mu><mu2>1.0</mu2></ode>
          </friction>
        </surface>
      </collision>
      <visual name="base_visual">
        <geometry>
          <box><size>1.2 1.0 0.6</size></box>
        </geometry>
        <material>
          <ambient>0.9 0.85 0.8 1</ambient>
          <diffuse>1 0.95 0.9 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="left_wheel1">
      <pose>1.14 -1.07 0.26 0 0 0</pose>
      <inertial><mass>10</mass><inertia><ixx>0.1</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.1</iyy><iyz>0</iyz><izz>0.1</izz></inertia></inertial>
      <collision name="left_wheel1_collision">
        <pose>0 0 0 -1.5708 0 0</pose>
        <geometry><cylinder><radius>0.27</radius><length>0.33</length></cylinder></geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.5</mu><mu2>2.0</mu2>
              <slip1>0</slip1><slip2>0</slip2>
              <fdir1>0 0 1</fdir1>
            </ode>
          </friction>
          <contact>
            <ode><kp>1e7</kp><kd>1</kd></ode>
          </contact>
        </surface>
      </collision>
      <visual name="left_wheel1_visual">
        <pose>0 0 0 -1.5708 0 0</pose>
        <geometry><cylinder><radius>0.27</radius><length>0.33</length></cylinder></geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="left_wheel2">
      <pose>0.08 -1.2 0.26 0 0 0</pose>
      <inertial><mass>10</mass><inertia><ixx>0.1</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.1</iyy><iyz>0</iyz><izz>0.1</izz></inertia></inertial>
      <collision name="left_wheel2_collision">
        <pose>0 0 0 -1.5708 0 0</pose>
        <geometry><cylinder><radius>0.27</radius><length>0.33</length></cylinder></geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.5</mu><mu2>2.0</mu2>
              <slip1>0</slip1><slip2>0</slip2>
              <fdir1>0 0 1</fdir1>
            </ode>
          </friction>
          <contact>
            <ode><kp>1e7</kp><kd>1</kd></ode>
          </contact>
        </surface>
      </collision>
      <visual name="left_wheel2_visual">
        <pose>0 0 0 -1.5708 0 0</pose>
        <geometry><cylinder><radius>0.27</radius><length>0.33</length></cylinder></geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="left_wheel3">
      <pose>-1.07 -1.07 0.26 0 0 0</pose>
      <inertial><mass>10</mass><inertia><ixx>0.1</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.1</iyy><iyz>0</iyz><izz>0.1</izz></inertia></inertial>
      <collision name="left_wheel3_collision">
        <pose>0 0 0 -1.5708 0 0</pose>
        <geometry><cylinder><radius>0.27</radius><length>0.33</length></cylinder></geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.5</mu><mu2>2.0</mu2>
              <slip1>0</slip1><slip2>0</slip2>
              <fdir1>0 0 1</fdir1>
            </ode>
          </friction>
          <contact>
            <ode><kp>1e7</kp><kd>1</kd></ode>
          </contact>
        </surface>
      </collision>
      <visual name="left_wheel3_visual">
        <pose>0 0 0 -1.5708 0 0</pose>
        <geometry><cylinder><radius>0.27</radius><length>0.33</length></cylinder></geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="right_wheel1">
      <pose>1.14 1.07 0.26 0 0 0</pose>
      <inertial><mass>10</mass><inertia><ixx>0.1</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.1</iyy><iyz>0</iyz><izz>0.1</izz></inertia></inertial>
      <collision name="right_wheel1_collision">
        <pose>0 0 0 -1.5708 0 0</pose>
        <geometry><cylinder><radius>0.27</radius><length>0.33</length></cylinder></geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.5</mu><mu2>2.0</mu2>
              <slip1>0</slip1><slip2>0</slip2>
              <fdir1>0 0 1</fdir1>
            </ode>
          </friction>
          <contact>
            <ode><kp>1e7</kp><kd>1</kd></ode>
          </contact>
        </surface>
      </collision>
      <visual name="right_wheel1_visual">
        <pose>0 0 0 -1.5708 0 0</pose>
        <geometry><cylinder><radius>0.27</radius><length>0.33</length></cylinder></geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="right_wheel2">
      <pose>0.08 1.2 0.26 0 0 0</pose>
      <inertial><mass>10</mass><inertia><ixx>0.1</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.1</iyy><iyz>0</iyz><izz>0.1</izz></inertia></inertial>
      <collision name="right_wheel2_collision">
        <pose>0 0 0 -1.5708 0 0</pose>
        <geometry><cylinder><radius>0.27</radius><length>0.33</length></cylinder></geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.5</mu><mu2>2.0</mu2>
              <slip1>0</slip1><slip2>0</slip2>
              <fdir1>0 0 1</fdir1>
            </ode>
          </friction>
          <contact>
            <ode><kp>1e7</kp><kd>1</kd></ode>
          </contact>
        </surface>
      </collision>
      <visual name="right_wheel2_visual">
        <pose>0 0 0 -1.5708 0 0</pose>
        <geometry><cylinder><radius>0.27</radius><length>0.33</length></cylinder></geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="right_wheel3">
      <pose>-1.07 1.07 0.26 0 0 0</pose>
      <inertial><mass>10</mass><inertia><ixx>0.1</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.1</iyy><iyz>0</iyz><izz>0.1</izz></inertia></inertial>
      <collision name="right_wheel3_collision">
        <pose>0 0 0 -1.5708 0 0</pose>
        <geometry><cylinder><radius>0.27</radius><length>0.33</length></cylinder></geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.5</mu><mu2>2.0</mu2>
              <slip1>0</slip1><slip2>0</slip2>
              <fdir1>0 0 1</fdir1>
            </ode>
          </friction>
          <contact>
            <ode><kp>1e7</kp><kd>1</kd></ode>
          </contact>
        </surface>
      </collision>
      <visual name="right_wheel3_visual">
        <pose>0 0 0 -1.5708 0 0</pose>
        <geometry><cylinder><radius>0.27</radius><length>0.33</length></cylinder></geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="left_wheel1_j" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel1</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>
    <joint name="left_wheel2_j" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel2</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>
    <joint name="left_wheel3_j" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel3</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>
    <joint name="right_wheel1_j" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel1</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>
    <joint name="right_wheel2_j" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel2</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>
    <joint name="right_wheel3_j" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel3</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>

    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel1_j</left_joint>
      <left_joint>left_wheel2_j</left_joint>
      <left_joint>left_wheel3_j</left_joint>
      <right_joint>right_wheel1_j</right_joint>
      <right_joint>right_wheel2_j</right_joint>
      <right_joint>right_wheel3_j</right_joint>
      <wheel_separation>2.14</wheel_separation>
      <wheel_radius>0.27</wheel_radius>
      <topic>/rover/cmd_vel</topic>
      <odom_topic>/rover/odometry</odom_topic>
      <tf_topic>/rover/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>20</odom_publish_frequency>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/rover/joint_states</topic>
    </plugin>

    <!-- LiDAR sensor link — mounted on top of the rover chassis -->
    <link name="lidar_link">
      <!--
        Pose is relative to the model origin.
        0 0 1.15 means: centred (0,0) and 1.15m above model origin.
        The base_link is at z=0.8 and the chassis box is 0.6m tall,
        so top of chassis is at z=0.8+0.3=1.1m. We place LiDAR at 1.15m.
      -->
      <pose>0 0 1.15 0 0 0</pose>

      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.000041</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000041</iyy><iyz>0</iyz>
          <izz>0.000080</izz>
        </inertia>
      </inertial>

      <visual name="lidar_visual">
        <geometry>
          <cylinder><radius>0.05</radius><length>0.07</length></cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>

      <collision name="lidar_collision">
        <geometry>
          <cylinder><radius>0.05</radius><length>0.07</length></cylinder>
        </geometry>
      </collision>

      <sensor name="lidar" type="gpu_lidar">
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <!--
          Topic name here is the Gazebo-internal topic.
          The bridge in sim.launch.py translates /scan → ROS /scan.
          These must match.
        -->
        <topic>/scan</topic>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.15</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.015</stddev>
          </noise>
        </ray>
      </sensor>
    </link>

    <!-- Fixed joint attaching LiDAR to rover chassis -->
    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_link</child>
    </joint>
  </model>
</sdf>
